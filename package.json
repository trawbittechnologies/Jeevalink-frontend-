{
  "name": "jeevalink-monorepo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx --yes concurrently \"npm --prefix frontend run dev\" \"npm run server\"",
    "client": "npm --prefix frontend run dev",
    "server": "cd jeevalink-backend-laravel && php artisan serve --port=8000",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview"
  }
}
