{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://jeevalink-backend-production.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://jeevalink-backend-production.up.railway.app/storage/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
