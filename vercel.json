{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://jeevalink-backend-production.up.railway.app/api/$1" },
    { "source": "/storage/(.*)", "destination": "https://jeevalink-backend-production.up.railway.app/storage/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
